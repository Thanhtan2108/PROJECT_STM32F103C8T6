"adc_pooling\stm32f1xx_hal.o"
"adc_pooling\stm32f1xx_hal_rcc.o"
"adc_pooling\stm32f1xx_hal_rcc_ex.o"
"adc_pooling\stm32f1xx_hal_gpio.o"
"adc_pooling\stm32f1xx_hal_dma.o"
"adc_pooling\stm32f1xx_hal_cortex.o"
